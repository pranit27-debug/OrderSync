# file: .gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go vendor directory
vendor/

# Docker-compose data volumes
postgres-data/
redis-data/

# Environment files and local configs
.env
configs/config.yaml
